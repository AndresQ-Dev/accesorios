---
// THESIS: A bright, single-purpose counter tool refuses dashboard clutter.
// OWN-WORLD: Cool shop-floor white, ink, cobalt action, and high-contrast utility surfaces.
// STORY: Enter an identifier, receive one current whole-peso price, recover in place.
// FIRST VIEWPORT: Search is visible immediately; the returned price owns the lower half.
// FORM: Restrained Operate surface for portrait phone use; manual lookup is the primary task.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f7f3" />
    <title>Price check</title>
  </head>
  <body>
    <main>
      <header>
        <p class="kicker">SHOP TOOL</p>
        <h1>Check a price</h1>
        <p class="intro">Search by code, barcode, article, brand, or category.</p>
      </header>

      <form id="lookup-form" novalidate>
        <label for="query">Code or article</label>
        <div class="search-row">
          <input id="query" name="query" type="search" inputmode="text" autocomplete="off" enterkeyhint="search" placeholder="Enter a code or article" />
          <button type="submit">Search</button>
        </div>
      </form>

      <button class="scan" id="scan" type="button" aria-describedby="scan-note">Scan barcode</button>
      <p class="scan-note" id="scan-note">Camera stays on this device. You can always search manually.</p>
      <section class="scanner" id="scanner" aria-label="Barcode scanner" hidden>
        <div class="scan-band"><video id="camera" muted playsinline></video></div>
        <p>Hold the barcode inside the band. Improve the light or steady the phone if it is blurry.</p>
        <div class="scanner-actions"><button id="torch" type="button" hidden>Turn on light</button><button id="cancel-scan" type="button">Cancel scan</button></div>
      </section>

      <section id="status" class="status" aria-live="polite" aria-atomic="true" role="status">
        Enter a code or article to see the current price.
      </section>
      <article id="result" class="result" aria-busy="false" hidden></article>
    </main>

    <script>
      import { createBrowserScanner, type ScannerState } from '../client/scanner';

      type SearchResult = { code: string; brand: string; article: string; category: string; priceArs: number };
      type SearchResponse = { results: SearchResult[]; freshness: string | null };
      const form = document.querySelector<HTMLFormElement>('#lookup-form')!;
      const input = document.querySelector<HTMLInputElement>('#query')!;
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const status = document.querySelector<HTMLElement>('#status')!;
      const result = document.querySelector<HTMLElement>('#result')!;
      const scan = document.querySelector<HTMLButtonElement>('#scan')!;
      const scannerPanel = document.querySelector<HTMLElement>('#scanner')!;
      const camera = document.querySelector<HTMLVideoElement>('#camera')!;
      const torch = document.querySelector<HTMLButtonElement>('#torch')!;
      const cancelScan = document.querySelector<HTMLButtonElement>('#cancel-scan')!;

      function formatArs(value: number) {
        return new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(value);
      }

      function setStatus(message: string, tone = 'info') {
        status.textContent = message;
        status.dataset.tone = tone;
      }

      function showLoading() {
        result.hidden = false;
        result.dataset.loading = 'true';
        result.setAttribute('aria-busy', 'true');
        result.replaceChildren(document.createElement('div'));
        setStatus('Checking the current price…', 'loading');
      }

      function showResult(item: SearchResult, freshness: string | null) {
        const brand = document.createElement('p'); brand.className = 'brand'; brand.textContent = item.brand;
        const article = document.createElement('h2'); article.textContent = item.article;
        const price = document.createElement('p'); price.className = 'price'; price.textContent = formatArs(item.priceArs);
        const details = document.createElement('p'); details.className = 'details'; details.textContent = `${item.category} · ${item.code}`;
        const updated = document.createElement('p'); updated.className = 'freshness';
        updated.textContent = freshness ? `Catalog updated ${new Date(freshness).toLocaleString('en-AR')}` : 'Catalog freshness unavailable';
        result.dataset.loading = 'false'; result.setAttribute('aria-busy', 'false'); result.replaceChildren(brand, article, price, details, updated);
        setStatus('Current price found.', 'success');
      }

      async function lookup(query: string, decoded = false) {
        if (!query) { setStatus('Enter a code, article, brand, or category to search.', 'error'); input.focus(); return; }
        submit.disabled = true; showLoading();
        try {
          const response = await fetch(`/api/v1/search?q=${encodeURIComponent(query)}`, { headers: { accept: 'application/json' } });
          if (response.status === 400) throw new Error('invalid-query');
          if (!response.ok) throw new Error('server-failure');
          const data = await response.json() as SearchResponse;
          if (data.results.length === 0) { result.hidden = true; setStatus(decoded ? 'Barcode decoded, but no matching price was found. Try a manual search.' : 'No matching price was found. Check the code or try a different article.', 'empty'); return; }
          showResult(data.results[0], data.freshness);
        } catch (error) {
          result.hidden = true;
          setStatus(error instanceof Error && error.message === 'invalid-query'
            ? 'Enter a valid code or article, then try again.'
            : 'Unable to check the price right now. Check the connection and try again.', 'error');
        } finally { submit.disabled = false; result.setAttribute('aria-busy', 'false'); }
      }

      function scannerState(state: ScannerState) {
        const messages: Record<ScannerState, string> = {
          insecure: 'Camera scanning needs HTTPS. Manual search is still available.', unsupported: 'This browser cannot scan this barcode. Use manual search.',
          'permission-denied': 'Camera permission was denied. Allow it in browser settings or search manually.', 'camera-error': 'The camera could not start. Close other camera apps and try again.',
          scanning: 'Scanning locally. No camera images leave this device.', slow: 'Still looking. Improve the light, hold steady, or search manually.',
        };
        setStatus(messages[state], state === 'scanning' ? 'info' : 'error');
      }
      const scanner = createBrowserScanner(camera, {
        onState: scannerState, onTorch: (available) => { torch.hidden = !available; },
        onDecode: (text) => { scannerPanel.hidden = true; input.value = text; setStatus('Barcode decoded. Checking the current price…', 'loading'); void lookup(text, true); },
      });
      function closeScanner(message = 'Scan cancelled. Manual search is ready.') { scanner.stop(); scannerPanel.hidden = true; torch.hidden = true; setStatus(message); scan.focus(); }
      scan.addEventListener('click', () => { scannerPanel.hidden = false; torch.hidden = true; torch.textContent = 'Turn on light'; void scanner.start(); });
      cancelScan.addEventListener('click', () => closeScanner());
      torch.addEventListener('click', async () => { const on = torch.textContent === 'Turn on light'; if (await scanner.toggleTorch(on)) torch.textContent = on ? 'Turn off light' : 'Turn on light'; });
      document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') scanner.stop(); });
      window.addEventListener('pagehide', () => scanner.stop());
      form.addEventListener('submit', (event) => { event.preventDefault(); void lookup(input.value.trim()); });
    </script>
  </body>
</html>

<style>
  :root { color: #14202a; background: #f4f7f3; font-family: system-ui, sans-serif; }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 20rem; min-height: 100svh; background: #f4f7f3; }
  main { width: min(100%, 38rem); min-height: 100svh; margin: auto; padding: max(2rem, env(safe-area-inset-top)) max(1.25rem, env(safe-area-inset-right)) max(2rem, env(safe-area-inset-bottom)) max(1.25rem, env(safe-area-inset-left)); }
  header { margin-bottom: 2rem; }
  .kicker { margin: 0 0 .5rem; color: #315c56; font-size: .75rem; font-weight: 750; letter-spacing: .08em; }
  h1 { margin: 0; font-size: 2rem; line-height: 1.1; letter-spacing: -.03em; }
  .intro { max-width: 34rem; margin: .75rem 0 0; color: #45555d; line-height: 1.5; }
  form { padding: 1.25rem; border: 1px solid #c9d3d1; background: #fff; box-shadow: 0 8px 20px rgb(20 32 42 / 10%); }
  label { display: block; margin-bottom: .5rem; font-weight: 700; }
  .search-row { display: grid; gap: .75rem; }
  input, button { min-height: 48px; border-radius: .35rem; font: inherit; }
  input { width: 100%; border: 1px solid #80908f; padding: 0 .875rem; color: #14202a; background: #fff; }
  button { border: 1px solid #0c4cc6; padding: 0 1rem; color: #fff; background: #0c4cc6; font-weight: 750; cursor: pointer; }
  button:hover { background: #083a99; }
  button:disabled { border-color: #9ca7ae; color: #56646c; background: #e4e9e9; cursor: not-allowed; }
  :focus-visible { outline: 3px solid #f5b800; outline-offset: 3px; }
  .scan { width: 100%; margin-top: 1rem; }
  .scan-note, .freshness { margin: .5rem 0 0; color: #52616a; font-size: .875rem; line-height: 1.45; }
  .scanner { margin-top: 1rem; padding: 1rem; border: 1px solid #80908f; background: #e8efed; }
  .scan-band { position: relative; overflow: hidden; min-height: 10rem; background: #14202a; }
  .scan-band::after { position: absolute; inset: 42% .75rem; border: 2px solid #f5b800; content: ''; pointer-events: none; }
  video { display: block; width: 100%; min-height: 10rem; object-fit: cover; }
  .scanner p { margin: .75rem 0; line-height: 1.45; }
  .scanner-actions { display: grid; gap: .75rem; }
  #cancel-scan { border-color: #52616a; background: #fff; color: #14202a; }
  .status { min-height: 3rem; margin: 1.5rem 0 0; font-weight: 650; line-height: 1.45; }
  .status[data-tone="error"] { color: #9b1c1c; }
  .status[data-tone="success"] { color: #14644f; }
  .result { border-top: .4rem solid #0c4cc6; padding: 1.5rem 0 0; }
  .result[data-loading="true"] div { width: 78%; height: 9rem; background: #dce5e4; animation: pulse 900ms ease-in-out infinite alternate; }
  .brand, .details, .price { margin: 0; }
  .brand { color: #315c56; font-size: .875rem; font-weight: 800; }
  h2 { margin: .25rem 0 .75rem; font-size: 1.5rem; line-height: 1.2; }
  .price { color: #0a402f; font-size: 3rem; font-weight: 800; line-height: 1; letter-spacing: -.04em; }
  .details { margin-top: .875rem; font-weight: 700; }
  @keyframes pulse { to { opacity: .52; } }
  @media (min-width: 34rem) { .search-row { grid-template-columns: 1fr auto; } .scanner-actions { grid-template-columns: auto auto; justify-content: start; } }
  @media (max-height: 32rem) and (orientation: landscape) { main { padding-top: 1rem; padding-bottom: 1rem; } header { margin-bottom: 1rem; } .intro { display: none; } .price { font-size: 2.5rem; } }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; scroll-behavior: auto !important; } }
</style>

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/client/**/*.ts",
    "scripts/build-python-static.mjs",
    "vitest.config.ts",
    "tests/unit/scanner.spec.ts",
    "tests/unit/public-lookup.spec.ts",
    "tests/unit/pwa.spec.ts",
    "tests/unit/scanner-layout.spec.ts",
    "tests/unit/admin-import-layout.spec.ts",
    "tests/unit/login-resilience.spec.ts"
  ]
}
